          area += 0.5 * abs(sum(x[i]*y[(i+1)%len(y)] - x[(i+1)%len(x)]*y[i] for i in range(len(x))))\n","        return area\n","    if ann.get(\"area\"):\n","        return float(ann[\"area\"])\n","    max_area = 0\n","    for key, val in ann.items():\n","        if isinstance(val, list) and len(val) > 0 and isinstance(val[0], list):\n","            for sub in val:\n","                if len(sub) == 4:\n","                    a = abs(sub[2]*sub[3])\n","                elif len(sub) >= 6:\n","                    a = poly_area([sub])\n","                else:\n","                    continue\n","                if a > max_area:\n","                    max_area = a\n","    return max_area\n","\n","def process_split_seg(file_list, split_name, zip_ref, max_area_ratio=0.3):\n","    missing_img, total_excluded, skipped = 0, 0, 0\n","    for filename in file_list:\n","        label_out = SEG_DIR / \"labels\" / split_name / (Path(filename).stem + \".txt\")\n","        dst_img = SEG_DIR / \"images\" / split_name / filename\n","\n","        # 이미 처리된 파일은 건너뛰기 (재개 가능하게)\n","        if label_out.exists() and dst_img.exists():\n","            skipped += 1\n","            continue\n","\n","        json_entry = filename_to_zipjson[filename]\n","        with zip_ref.open(json_entry) as f:\n","            data = json.load(f)\n","\n","        img_info = data[\"images\"][0]\n","        img_w, img_h = img_info[\"width\"], img_info[\"height\"]\n","        cat_map = {c[\"id\"]: c[\"name\"] for c in data[\"categories\"]}\n","\n","        lines = []\n","        for ann in data[\"annotations\"]:\n","            cat_name = cat_map.get(ann[\"category_id\"], \"\")\n","            cls = \"균열\" if \"균열\" in cat_name else (\"포트홀\" if \"홀\" in cat_name else None)\n","            if cls is None:\n","                continue\n","\n","            area = get_robust_area_seg(ann)\n","            img_total = img_w * img_h\n","            if area > img_total * max_area_ratio:\n","                total_excluded += 1\n","                continue\n","\n","            polygons = get_seg_polygons(ann, img_w, img_h)\n","            for poly in polygons:\n","                coords_str = \" \".join(f\"{c:.6f}\" for c in poly)\n","                lines.append(f\"{CLASS_MAP[cls]} {coords_str}\")\n","\n","        with open(label_out, \"w\") as f:\n","            f.write(\"\\n\".join(lines))\n","\n","        src_img = photo_path_map.get(filename)\n","        if src_img is None:\n","            missing_img += 1\n","            continue\n","        shutil.copy(src_img, dst_img)\n","\n","    return missing_img, total_excluded, skipped\n","\n","with zipfile.ZipFile(BASE_DIR / \"라벨데이터\" / \"TL01.zip\", 'r') as z:\n","    print(\"train 처리 중...\")\n","    miss_train, excl_train, skip_train = process_split_seg(train_files, \"train\", z)\n","    print(\"val 처리 중...\")\n","    miss_val, excl_val, skip_val = process_split_seg(val_files, \"val\", z)\n","\n","print(f\"\\n✅ 완료! 이미지 못 찾음: train {miss_train}, val {miss_val}\")\n","print(f\"✅ 이상치 제외: train {excl_train}, val {excl_val}\")\n","print(f\"✅ 이미 처리되어 건너뜀(재개분): train {skip_train}, val {skip_val}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"AONZyB9APi1n","executionInfo":{"status":"ok","timestamp":1788441124701,"user_tz":-540,"elapsed":2473675,"user":{"displayName":"민서조","userId":"17376382852708856163"}},"outputId":"a532c757-1120-4a99-8571-3e1f57d48f5a"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["train 처리 중...\n","val 처리 중...\n","\n","✅ 완료! 이미지 못 찾음: train 0, val 0\n","✅ 이상치 제외: train 66, val 24\n","✅ 이미 처리되어 건너뜀(재개분): train 0, val 0\n"]}]},{"cell_type":"code","source":["yaml_content = f\"\"\"path: {SEG_DIR}\n","train: images/train\n","val: images/val\n","\n","names:\n","  0: 도로균열\n","  1: 도로홀\n","\"\"\"\n","with open(SEG_DIR / \"data.yaml\", \"w\", encoding=\"utf-8\") as f:\n","    f.write(yaml_content)\n","\n","print(\"✅ data.yaml 생성 완료\")"],"metadata":{"colab":{"base_uri