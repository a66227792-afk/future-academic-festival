","\n","CLASS_MAP = {\"균열\": 0, \"포트홀\": 1}\n","filename_to_zipjson = {**crack_map, **pothole_map}\n","\n","def get_bbox_from_ann(ann):\n","    for key, val in ann.items():\n","        if isinstance(val, list) and len(val) > 0 and isinstance(val[0], list):\n","            for sub in val:\n","                if len(sub) == 4:\n","                    x, y, w, h = sub\n","                    return [x, y, x + w, y + h]\n","                elif len(sub) >= 6:\n","                    xs = sub[0::2]\n","                    ys = sub[1::2]\n","                    return [min(xs), min(ys), max(xs), max(ys)]\n","    return None\n","\n","# ⭐ 이상치 필터 함수 (윤수 엑셀 수정할 때 만든 것과 동일)\n","def calculate_polygon_area(segmentation):\n","    area = 0.0\n","    for poly in segmentation:\n","        if len(poly) < 6:\n","            continue\n","        x = poly[0::2]\n","        y = poly[1::2]\n","        area += 0.5 * abs(sum(\n","            x[i] * y[(i+1) % len(y)] - x[(i+1) % len(x)] * y[i]\n","            for i in range(len(x))\n","        ))\n","    return area\n","\n","def get_area_from_seg_like_list(val):\n","    total = 0.0\n","    for sub in val:\n","        if not isinstance(sub, list):\n","            continue\n","        if len(sub) == 4:\n","            total += abs(sub[2] * sub[3])\n","        elif len(sub) >= 6:\n","            total += calculate_polygon_area([sub])\n","    return total\n","\n","def get_robust_area(ann):\n","    if ann.get(\"area\"):\n","        return float(ann[\"area\"])\n","    max_area = 0\n","    for key, val in ann.items():\n","        if isinstance(val, list):\n","            if \"bbox\" in key.lower() and len(val) == 4 and all(isinstance(v, (int, float)) for v in val):\n","                area = val[2] * val[3]\n","                if area > max_area:\n","                    max_area = area\n","            elif len(val) > 0 and isinstance(val[0], list):\n","                seg_area = get_area_from_seg_like_list(val)\n","                if seg_area > max_area:\n","                    max_area = seg_area\n","            elif len(val) > 4 and all(isinstance(v, (int, float)) for v in val):\n","                poly_area = calculate_polygon_area([val])\n","                if poly_area > max_area:\n","                    max_area = poly_area\n","    return max_area\n","\n","def get_valid_annotations(data, max_area_ratio=0.3):\n","    \"\"\"이미지 면적의 30%를 넘는 이상 annotation은 제외\"\"\"\n","    img_info = data[\"images\"][0]\n","    image_total_area = img_info[\"width\"] * img_info[\"height\"]\n","    max_allowed = image_total_area * max_area_ratio\n","    valid_anns = []\n","    excluded_count = 0\n","    for ann in data[\"annotations\"]:\n","        area = get_robust_area(ann)\n","        if area <= max_allowed:\n","            valid_anns.append(ann)\n","        else:\n","            excluded_count += 1\n","    return valid_anns, excluded_count\n","\n","\n","def process_split(file_list, split_name, zip_ref):\n","    missing_img = 0\n","    total_excluded = 0\n","    for filename in file_list:\n","        json_entry = filename_to_zipjson[filename]\n","        with zip_ref.open(json_entry) as f:\n","            data = json.load(f)\n","\n","        img_info = data[\"images\"][0]\n","        img_w, img_h = img_info[\"width\"], img_info[\"height\"]\n","\n","        # ⭐ 이상치 제외한 유효 annotation만 사용\n","        valid_anns, excluded = get_valid_annotations(data, max_area_ratio=0.3)\n","        total_excluded += excluded\n","\n","        lines = []\n","        for ann in valid_anns:\n","            cat_map = {c[\"id\"]: c[\"name\"] for c in data[\"categories\"]}\n","            cat_name = cat_map.get(ann[\"category_id\"], \"\")\n","            cls = \"균열\" if \"균열\" in cat_name else (\"포트홀\" if \"홀\" in cat_name else None)\n","            if cls is None:\n","                continue\n","            bbox = get_bbox_from_ann(ann)\n","            if bbox is None:\n","                continue\n","            xmin, ymin, xmax, ymax = bbox\n","            x_center = ((xmin + xmax) / 2) / img_w\n","            y_center = ((ymin + ymax) / 2) / img_h\n","            w_norm = (xmax - xmin) / img_w\n","            h_norm = (ymax - ymin) / img_h\n","            lines.append(f\"{CLASS_MAP[cls]} {x_center:.6f} {y_center:.6f} {w_norm:.6f} {h_norm:.6f}\")\n","\n","        label_out = YOLO_DIR / \"labels\" / split_name / (Path(filename).stem + \".txt\")\n","        with open(label_out, \"w\") as f:\n","            f.write(\"\\n\".join(lines))\n","\n","        src_img = photo_path_map.get(filename)\n","        if src_img is None:\n","            missing_img += 1\n","            continue\n","        dst_img = YOLO_DIR / \"images\" / split_name / filename\n","        shutil.copy(src_img, dst_img)\n","\n","    return missing_img, total_excluded\n","\n","with zipfile.ZipFile(zip_path, 'r') as z:\n","    print(\"train 처리 중...\")\n","    miss_train, excl_train = process_split(train_files, \"train\", z)\n","    print(\"val 처리 중...\")\n","    miss_val, excl_val = process_split(val_files, \"val\", z)\n","\n","print(f\"\\n✅ 완료! 이미지 못 찾은 경우: train {miss_train}건, val {miss_val}건\")\n","print(f\"✅ 이상치로 제외된 annotation: train {excl_train}건, val {excl_val}건\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"rqsFnjOo4iTc","executionInfo":{"status":"ok","timestamp":1788250877496,"user_tz":-540,"elapsed":2763622,"user":{"displayName":"민서조","userId":"17376382852708856163"}},"outputId":"cbdff14e-12b7-4a28-cabc-fd13f784c2ca"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["train 처리 중...\n","val 처리 중...\n","\n","✅ 완료! 이미지 못 찾은 경우: train 0건, val 0건\n","✅ 이상치로 제외된 annotation: train 66건, val 24건\n"]}]},{"cell_type":"code","source":["from pathlib import Path\n","\n","YOLO_DIR = BASE_DIR / \"조민서\" / \"yolo_데이터셋\"\n","\n","# 라벨 폴더 안 파일 개수와 최근 수정 시각 확인\n","label_files = list((YOLO_DIR / \"labels\" / \"train\").glob(\"*.txt\"))\n","print(f\"라벨 파일 개수: {len(label_files)}\")\n","\n","if label_file