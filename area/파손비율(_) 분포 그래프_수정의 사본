        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"\\ub4f1\\uae09\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 1,\n        \"samples\": [\n          \"\\uc77c\\ubc18\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["저장 완료: /content/drive/MyDrive/3-여름학기/미래학술제/조민서/최종_면적기준_수정본_결과.xlsx\n"]}],"source":["# ============================================================\n","# 0. 기본 설정 + Google Drive 연결\n","# ============================================================\n","import os, json, unicodedata\n","import pandas as pd\n","import matplotlib.pyplot as plt\n","from shapely.geometry import LineString\n","from shapely.ops import unary_union\n","from google.colab import drive\n","drive.mount(\"/content/drive\")\n","\n","# ============================================================\n","# 1. 경로 / 설정\n","# ============================================================\n","json_dir = \"/content/drive/MyDrive/3-여름학기/미래학술제/최종테스트셋/최종_라벨\"\n","output_excel = \"/content/drive/MyDrive/3-여름학기/미래학술제/조민서/최종_면적기준_수정본_결과.xlsx\"\n","\n","WIDTH_PX = 12   # 균열 선 폭(픽셀). 8~16으로 바꿔도 결과 거의 같음\n","\n","# ============================================================\n","# 2. 면적 계산 함수\n","# ============================================================\n","def calculate_polygon_area(segmentation):\n","    area = 0.0\n","    for poly in segmentation:\n","        if len(poly) < 6:\n","            continue\n","        x = poly[0::2]\n","        y = poly[1::2]\n","        area += 0.5 * abs(sum(\n","            x[i] * y[(i + 1) % len(y)] - x[(i + 1) % len(x)] * y[i]\n","            for i in range(len(x))\n","        ))\n","    return area\n","\n","def get_area_from_seg_like_list(val):      # 포트홀용\n","    total = 0.0\n","    for sub in val:\n","        if not isinstance(sub, list):\n","            continue\n","        if len(sub) == 4:                  # [x, y, w, h]\n","            total += abs(sub[2] * sub[3])\n","        elif len(sub) >= 6:                # Polygon\n","            total += calculate_polygon_area([sub])\n","    return total\n","\n","def get_pothole_area(ann):                 # 포트홀 1개 면적\n","    if ann.get(\"area\"):\n","        return float(ann[\"area\"])\n","    return get_area_from_seg_like_list(ann.get(\"segmentation\") or [])\n","\n","def calculate_crack_area(segs, width=WIDTH_PX):   # 균열: 선을 띠로 보고 겹침 없이 합산\n","    shapes = []\n","    for s in segs:\n","        if not isinstance(s, list) or len(s) < 4:\n","            continue\n","        line = LineString(list(zip(s[0::2], s[1::2])))\n","        if line.length > 0:\n","            shapes.append(line.buffer(width / 2))\n","    return unary_union(shapes).area if shapes else 0.0\n","\n","# ============================================================\n","# 3. 300장 전체 계산\n","# ============================================================\n","json_files = sorted(f for f in os.listdir(json_dir) if f.lower().endswith(\".json\"))\n","print(\"JSON 파일 수:\", len(json_files))\n","\n","results = []\n","for filename in json_files:\n","    with open(os.path.join(json_dir, filename), \"r\", encoding=\"utf-8\") as f:\n","        data = json.load(f)\n","\n","    cat_map = {c[\"id\"]: c[\"name\"] for c in data[\"categories\"]}\n","    image_total_area = float(data[\"images\"][0][\"width\"]) * float(data[\"images\"][0][\"height\"])\n","\n","    crack_segs, pothole_area = [], 0.0\n","    for ann in data[\"annotations\"]:\n","        cat_name = unicodedata.normalize(\"NFC\", str(cat_map.get(ann.get(\"category_id\"), \"\")))\n","        if \"균열\" in cat_name:\n","            crack_segs += ann.get(\"segmentation\") or []\n","        elif \"홀\" in cat_name:\n","            pothole_area += get_pothole_area(ann)\n","\n","    crack_area = calculate_crack_area(crack_segs)\n","    total_damage_area = crack_area + pothole_area\n","    damage_ratio = total_damage_area / image_total_area * 100\n","\n","    if total_damage_area == 0:\n","        final_type = \"확인필요\"\n","    elif crack_area >= pothole_area:\n","        final_type = \"균열\"\n","    else:\n","        final_type = \"포트홀\"\n","\n","    results.append({\n","        \"파일명\": os.path.splitext(filename)[0] + \".jpg\",\n","        \"정답유형(면적기준)\": final_type,\n","        \"이미지전체면적\": image_total_area,\n","        \"균열면적\": crack_area,\n","        \"포트홀면적\": pothole_area,\n","        \"총파손면적\": total_damage_area,\n","        \"파손비율(%)\": damage_ratio,\n","    })\n","\n","df = pd.DataFrame(results)\n","\n","# 등급 (2% / 5% 기준)\n","df[\"등급\"] = pd.cut(df[\"파손비율(%)\"], bins=[0, 2, 5, float(\"inf\")],\n","                    labels=[\"일반\", \"보통\", \"긴급\"], right=False, include_lowest=True)\n","\n","print(\"최종 사진 수:\", len(df))\n","print(\"최대 파손비율:\", round(df[\"파손비율(%)\"].max(), 2), \"%  (10% 근처면 정상)\")\n","print(df[\"등급\"].value_counts().reindex([\"일반\", \"보통\", \"긴급\"]))   # 기대값 246 / 37 / 17\n","display(df.head())\n","\n","# ============================================================\n","# 4. 저장\n","# ============================================================\n","df.to_excel(output_excel, index=False)\n","print(\"저장 완료:\", output_excel)"]},{"cell_type":"code","source":["!pip install -q koreanize-matplotlib\n","import koreanize_matplotlib"],"metadata":{"id":"tEN4t7FMYKun","executionInfo":{"status":"ok","timestamp":1793272630368,"user_tz":-540,"elapsed":7435,"user":{"displayName":"민서조","userId":"17376382852708856163"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["# ============================================================\n","# ① 파손비율 분포\n","# ============================================================\n","\n","bins = [0, 1, 2, 5, 10, 100]\n","labels = [\"0~1%\", \"1~2%\", \"2~5%\", \"5~10%\", \"10% 이상\"]\n","\n","df[\"파손비율구간\"] = pd.cut(df[\"파손비율(%)\"], bins=bins, labels=labels,\n","                           right=False, in