{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[]},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"id":"BxPUBh6QF-Yd","executionInfo":{"status":"ok","timestamp":1793271815909,"user_tz":-540,"elapsed":218,"user":{"displayName":"민서조","userId":"17376382852708856163"}}},"outputs":[],"source":["# ============================================================\n","# 사진 1장 실시간 파손비율 계산 함수 (균열 면적 계산 수정본)\n","# - 균열: 선(좌표)을 폭 CRACK_WIDTH_PX 의 띠로 보고 면적 계산\n","# - 포트홀: [x, y, width, height] 형태면 width × height\n","#\n","# 수정 이유: 균열 라벨 중 점 2개짜리 [x1, y1, x2, y2] 는 선인데,\n","#           기존 코드는 숫자 4개를 [x, y, w, h] 사각형으로 읽어서\n","#           균열 면적이 크게 부풀려졌다.\n","# 수정 내용: ① calculate_crack_area 추가\n","#           ② calculate_single_image_damage_ratio 의 균열 계산 교체\n","# ============================================================\n","\n","import unicodedata\n","from shapely.geometry import LineString\n","from shapely.ops import unary_union\n","\n","CRACK_WIDTH_PX = 12   # 균열 선 폭(픽셀). 8~16으로 바꿔도 결과가 거의 같음\n","\n","\n","# ------------------------------------------------------------\n","# [추가] 균열 면적: 선을 폭 width 의 띠로 보고 겹침 없이 합산\n","# ------------------------------------------------------------\n","\n","def calculate_crack_area(crack_segs, width=CRACK_WIDTH_PX):\n","    shapes = []\n","    for s in crack_segs:\n","        if not isinstance(s, list) or len(s) < 4:\n","            continue\n","        pts = list(zip(s[0::2], s[1::2]))\n","        line = LineString(pts)\n","        if line.length > 0:\n","            shapes.append(line.buffer(width / 2))\n","    return unary_union(shapes).area if shapes else 0.0\n","\n","\n","# ------------------------------------------------------------\n","# 1. Polygon 면적 계산 (포트홀용, 기존 그대로)\n","# ------------------------------------------------------------\n","\n","def calculate_polygon_area(segmentation):\n","    area = 0.0\n","    for poly in segmentation:\n","        if len(poly) < 6:\n","            continue\n","        x = poly[0::2]\n","        y = poly[1::2]\n","        area += 0.5 * abs(\n","            sum(\n","                x[i] * y[(i + 1) % len(y)]\n","                - x[(i + 1) % len(x)] * y[i]\n","                for i in range(len(x))\n","            )\n","        )\n","    return area\n","\n","\n","# ------------------------------------------------------------\n","# 2. segmentation 안에 Polygon / BBox 가 섞여 있어도 처리 (포트홀용, 기존 그대로)\n","# ------------------------------------------------------------\n","\n","def get_area_from_seg_like_list(val):\n","    total = 0.0\n","    for sub in val:\n","        if not isinstance(sub, list):\n","            continue\n","        if len(sub) == 4:                       # [x, y, width, height]\n","            total += abs(sub[2] * sub[3])\n","        elif len(sub) >= 6:                     # Polygon\n","            total += calculate_polygon_area([sub])\n","    return total\n","\n","\n","# ------------------------------------------------------------\n","# 3. Annotation 하나의 면적 계산 (포트홀용, 기존 그대로)\n","# ------------------------------------------------------------\n","\n","def get_robust_area(ann):\n","    if ann.get(\"area\"):\n","        return float(ann[\"area\"])\n","\n","    max_area = 0\n","    for key, val in ann.items():\n","        if isinstance(val, list):\n","            if (\n","                \"bbox\" in key.lower()\n","                and len(val) == 4\n","                and all(isinstance(v, (int, float)) for v in val)\n","            ):\n","                area = val[2] * val[3]\n","                if area > max_area:\n","                    max_area = area\n","            elif len(val) > 0 and isinstance(val[0], list):\n","                seg_area = get_area_from_seg_like_list(val)\n","                if seg_area > max_area:\n","                    max_area = seg_area\n","            elif len(val) > 4 and all(isinstance(v, (int, float)) for v in val):\n","                poly_area = calculate_polygon_area([val])\n","                if poly_area > max_area:\n","                    max_area = poly_area\n","    return max_area\n","\n","\n","# ============================================================\n","# 4. ★ 사진 1장 파손비율 계산 함수\n","# ============================================================\n","\n","def calculate_single_image_damage_ratio(data):\n","    \"\"\"\n","    사진 1장의 JSON 형태 분석 결과를 넣으면\n","    균열 면적, 포트홀 면적, 총 파손 면적, 파손비율(%), 면적 기준 파손 유형을 반환한다.\n","    \"\"\"\n","\n","    cat_map = {c[\"id\"]: c[\"name\"] for c in data[\"categories\"]}\n","\n","    # ---- [수정] 균열은 좌표를 모아서 한 번에 계산 ----\n","    crack_segs = []\n","    pothole_area = 0.0\n","\n","    for ann in data[\"annotations\"]:\n","        category_id = ann.get(\"category_id\")\n","        cat_name = unicodedata.normalize(\"NFC\", str(cat_map.get(category_id, \"\")))\n","\n","        if \"균열\" in cat_name:\n","            crack_segs += ann.get(\"segmentation\") or []\n","        elif \"홀\" in cat_name:\n","            pothole_area += get_robust_area(ann)\n","\n","    crack_area = calculate_crack_area(crack_segs)\n","\n","    # ---- 이하 기존 그대로 ----\n","    img_width = float(data[\"images\"][0][\"width\"])\n","    img_height = float(data[\"images\"][0][\"height\"])\n","    image_total_area = img_width * img_height\n","\n","    if image_total_area <= 0:\n","        raise ValueError(\"이미지 가로/세로 크기가 잘못되었습니다.\")\n","\n","    total_damage_area = crack_area + pothole_area\n","    damage_ratio = total_damage_area / image_total_area * 100\n","\n","    if crack_area == 0 and pothole_area == 0:\n","        final_type = \"확인필요\"\n","    elif crack_area >= pothole_area:\n","        final_type = \"균열\"\n","    else:\n","        final_type = \"포트홀\"\n","\n","    return {\n","        \"정답유형(면적기준)\": final_type,\n","        \"이미지전체면적\": image_total_area,\n","        \"균열면적\": crack_area,\n","        \"포트홀면적\": pothole_area,\n","        \"총파손면적\": total_damage_area,\n","        \"파손비율(%)\": damage_ratio,\n","    }"]}]}